# Copy to .env (optional). Every setting in duplexrag/config.py can be overridden as DUPLEXRAG_<NAME>.
DUPLEXRAG_THREADS=4
# DUPLEXRAG_CORPUS_DIR=/path/to/your/corpus
# DUPLEXRAG_CONTROLLER=hybrid            # rule | model | hybrid
# DUPLEXRAG_RETRIEVAL_MODE=hybrid        # hybrid | dense | bm25
# DUPLEXRAG_RERANK=true

# Optional LLM phrasing of the selected evidence (every sentence is verified before it is shown)
# DUPLEXRAG_SYNTHESIS=llm
# DUPLEXRAG_LLM_BASE_URL=http://localhost:11434/v1
# DUPLEXRAG_LLM_MODEL=qwen2.5:3b-instruct
# DUPLEXRAG_LLM_API_KEY=
# DUPLEXRAG_LLM_USD_PER_MTOK_IN=0
# DUPLEXRAG_LLM_USD_PER_MTOK_OUT=0
