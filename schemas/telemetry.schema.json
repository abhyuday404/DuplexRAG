{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/duplexrag/schemas/telemetry.schema.json",
  "title": "DuplexRAG telemetry event",
  "description": "One JSON Lines record per event. Every turn emits turn_started, chunk_received (per chunk), controller_decision (per chunk + final), answer_version, grounding_check and turn_completed; turns that retrieve also emit retrieval_started / retrieval_completed.",
  "type": "object",
  "required": ["seq", "event", "session_id", "t_stream", "t_wall"],
  "properties": {
    "seq": {"type": "integer", "description": "monotonic sequence number within the session"},
    "event": {"enum": ["session_started", "turn_started", "chunk_received", "controller_decision", "decomposition",
                       "retrieval_started", "retrieval_completed", "evidence_fused", "retrieval_suppressed",
                       "answer_started", "first_token", "answer_version", "grounding_check", "uncertainty_flag",
                       "turn_completed", "session_ended"]},
    "session_id": {"type": "string"},
    "turn_id": {"type": ["string", "null"]},
    "t_stream": {"type": "number", "description": "seconds on the stream clock (same clock as transcript chunk timestamps)"},
    "t_wall": {"type": "number", "description": "unix epoch seconds"}
  },
  "allOf": [
    {"if": {"properties": {"event": {"const": "chunk_received"}}},
     "then": {"required": ["text", "partial"],
              "properties": {"text": {"type": "string"}, "partial": {"type": "string", "description": "utterance so far"}}}},
    {"if": {"properties": {"event": {"const": "controller_decision"}}},
     "then": {"required": ["action", "gate", "reason", "final"],
              "properties": {
                "action": {"enum": ["wait", "retrieve", "suppress", "finalize"]},
                "gate": {"type": "object", "required": ["label", "confidence", "source"],
                         "properties": {"label": {"enum": ["retrieval", "refinement", "presentation", "chitchat", "undecided"]},
                                        "confidence": {"type": "number"}, "reason": {"type": "string"},
                                        "source": {"enum": ["rule", "model", "hybrid"]}}},
                "queries": {"type": "array", "items": {"type": "string"}},
                "final": {"type": "boolean"}}}},
    {"if": {"properties": {"event": {"const": "retrieval_started"}}},
     "then": {"required": ["qid", "query", "trigger"],
              "properties": {"qid": {"type": "string"}, "query": {"type": "string"}, "keywords": {"type": "string"},
                             "trigger": {"enum": ["provisional", "multi_intent", "refinement", "final"]},
                             "origin": {"type": "string", "description": "clause of the utterance the sub-query came from"}}}},
    {"if": {"properties": {"event": {"const": "retrieval_completed"}}},
     "then": {"required": ["qids", "t_dispatch", "t_start", "compute_ms", "used"],
              "properties": {"qids": {"type": "array", "items": {"type": "string"}},
                             "t_dispatch": {"type": "number"}, "t_start": {"type": "number"},
                             "compute_ms": {"type": "number"},
                             "used": {"type": "boolean", "description": "false = speculative result superseded (wasted)"},
                             "top": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
                             "stats": {"type": "object"}}}},
    {"if": {"properties": {"event": {"const": "first_token"}}},
     "then": {"required": ["ttft_ms"], "properties": {"ttft_ms": {"type": "number"}}}},
    {"if": {"properties": {"event": {"const": "answer_version"}}},
     "then": {"required": ["version", "kind", "text", "citations"],
              "properties": {"version": {"type": "integer"}, "kind": {"type": "string"}, "text": {"type": "string"},
                             "citations": {"type": "array", "items": {"type": "string", "pattern": "^\\S+ §\\d+$"}},
                             "diff": {"type": ["object", "null"],
                                      "properties": {"parent_version": {"type": "integer"},
                                                     "mode": {"enum": ["new_answer", "refine", "presentation"]},
                                                     "added": {"type": "array"}, "retired": {"type": "array"},
                                                     "retained": {"type": "array"}}},
                             "view": {"type": "string"}}}},
    {"if": {"properties": {"event": {"const": "grounding_check"}}},
     "then": {"required": ["claims", "supported", "support_rate", "fabricated_ids"],
              "properties": {"claims": {"type": "integer"}, "supported": {"type": "integer"},
                             "support_rate": {"type": "number"},
                             "fabricated_ids": {"type": "array", "items": {"type": "string"}},
                             "unretrieved_ids": {"type": "array", "items": {"type": "string"}}}}},
    {"if": {"properties": {"event": {"const": "uncertainty_flag"}}},
     "then": {"required": ["message"], "properties": {"intent_id": {"type": "string"}, "doc_id": {"type": "string"},
                                                      "message": {"type": "string"}}}},
    {"if": {"properties": {"event": {"const": "turn_completed"}}},
     "then": {"required": ["kind", "latency", "cost", "retrieved", "early_retrieval"],
              "properties": {
                "kind": {"enum": ["retrieval", "refinement", "presentation", "chitchat"]},
                "latency": {"type": "object", "required": ["ttft_ms", "first_retrieval_s", "retrieval_lead_ms"],
                            "properties": {"ttft_ms": {"type": ["number", "null"]},
                                           "first_retrieval_s": {"type": ["number", "null"]},
                                           "retrieval_lead_ms": {"type": ["number", "null"],
                                                                 "description": "how long before the end of the utterance retrieval started"},
                                           "post_utterance_retrieval_ms": {"type": "number"},
                                           "synthesis_ms": {"type": "number"}}},
                "cost": {"type": "object", "required": ["embed_tokens", "rerank_tokens", "cpu_ms", "usd"],
                         "properties": {"embed_tokens": {"type": "integer"}, "rerank_tokens": {"type": "integer"},
                                        "cpu_ms": {"type": "number"}, "usd": {"type": "number"},
                                        "llm_tokens_in": {"type": "integer"}, "llm_tokens_out": {"type": "integer"}}},
                "speculative": {"type": "object", "properties": {"dispatched": {"type": "integer"},
                                                                 "reused": {"type": "integer"},
                                                                 "wasted": {"type": "integer"}}},
                "retrieved": {"type": "boolean"}, "early_retrieval": {"type": "boolean"}}}}
  ]
}
